---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import FilterControls from '../components/FilterControls.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <FilterControls />

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid" id="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}

      {games.length > 0 && (
        <div id="empty-state-container" class="hidden">
          <EmptyState text="No games match your filters. Try adjusting your selections." />
        </div>
      )}
    </div>

    <!-- Store all games data for client-side filtering -->
    <script type="application/json" id="games-data" set:html={JSON.stringify(games)}></script>
  </div>

  <script>
    // Parse URL query parameters to extract filter selections
    function getQueryParams(): { categories: number[]; publishers: number[] } {
      const params = new URLSearchParams(window.location.search);
      return {
        categories: params.getAll('category').map(Number),
        publishers: params.getAll('publisher').map(Number),
      };
    }

    // Rebuild URL with current filter selections
    function updateURL(categoryIds: number[], publisherIds: number[]): void {
      const params = new URLSearchParams();
      categoryIds.forEach((id) => params.append('category', String(id)));
      publisherIds.forEach((id) => params.append('publisher', String(id)));

      const search = params.toString();
      const newURL = search ? `?${search}` : window.location.pathname;
      window.history.replaceState({}, '', newURL);
    }

    // Filter games based on selected category and publisher IDs
    function filterGames(
      games: ReturnType<typeof JSON.parse>,
      categoryIds: number[],
      publisherIds: number[]
    ): ReturnType<typeof JSON.parse> {
      return games.filter((game: Record<string, unknown>) => {
        const matchesCategory =
          categoryIds.length === 0 ||
          (game.category && categoryIds.includes((game.category as Record<string, number>).id));
        const matchesPublisher =
          publisherIds.length === 0 ||
          (game.publisher && publisherIds.includes((game.publisher as Record<string, number>).id));

        return matchesCategory && matchesPublisher;
      });
    }

    // Render games grid with filtered results
    function renderGames(filteredGames: ReturnType<typeof JSON.parse>): void {
      const grid = document.getElementById('games-grid');
      const emptyStateContainer = document.getElementById('empty-state-container');

      if (!grid || !emptyStateContainer) return;

      if (filteredGames.length === 0) {
        grid.classList.add('hidden');
        emptyStateContainer.classList.remove('hidden');
      } else {
        grid.classList.remove('hidden');
        emptyStateContainer.classList.add('hidden');

        // Update grid content
        grid.innerHTML = filteredGames
          .map((game: Record<string, unknown>) => {
            const id = (game.id as number);
            const starRating = (game.starRating as number | null)
              ? `<div class="text-yellow-400">★ ${((game.starRating as number) || 0).toFixed(1)}</div>`
              : '';
            const categoryTag = game.category
              ? `<span class="inline-block bg-blue-600/20 text-blue-300 px-3 py-1 rounded-lg text-sm">${(game.category as Record<string, string>).name}</span>`
              : '';
            const publisherTag = game.publisher
              ? `<span class="inline-block bg-purple-600/20 text-purple-300 px-3 py-1 rounded-lg text-sm">${(game.publisher as Record<string, string>).name}</span>`
              : '';

            return `
              <a href="/game/${id}" class="group block bg-slate-800/60 backdrop-blur-sm rounded-xl overflow-hidden shadow-lg border border-slate-700/50 hover:border-blue-500/50 hover:shadow-blue-500/10 hover:shadow-xl transition-all duration-300 hover:translate-y-[-6px]" data-testid="game-card" data-game-id="${id}">
                <div class="p-6 relative">
                  <div class="absolute inset-0 bg-gradient-to-r from-blue-600/10 to-purple-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  <div class="relative z-10">
                    <h3 class="text-xl font-semibold text-slate-100 mb-2 group-hover:text-blue-400 transition-colors" data-testid="game-title">${game.title}</h3>

                    ${starRating}

                    <p class="text-slate-400 mb-4 text-sm line-clamp-2" data-testid="game-description">${game.description}</p>

                    <div class="mt-4 text-sm text-blue-400 font-medium flex items-center">
                      <span>View details</span>
                      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" class="h-4 w-4 ml-1 transform transition-transform duration-300 group-hover:translate-x-2" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </div>
                  </div>
                </div>
              </a>
            `;
          })
          .join('');
      }
    }

    // Initialize filtering on page load
    function initializeFiltering(): void {
      const gamesDataElement = document.getElementById('games-data');
      if (!gamesDataElement) return;

      const games = JSON.parse(gamesDataElement.textContent || '[]');
      const { categories, publishers } = getQueryParams();

      // Set up checkboxes to reflect current query params
      document.querySelectorAll('input[type="checkbox"]').forEach((checkbox) => {
        const element = checkbox as HTMLInputElement;
        const isCategory = element.name === 'category';
        const isPublisher = element.name === 'publisher';
        const id = Number(element.value);

        if (isCategory) {
          element.checked = categories.includes(id);
        } else if (isPublisher) {
          element.checked = publishers.includes(id);
        }
      });

      // Filter and render games based on query params
      const filteredGames = filterGames(games, categories, publishers);
      renderGames(filteredGames);
    }

    // Handle checkbox changes
    document.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.type === 'checkbox' && (target.name === 'category' || target.name === 'publisher')) {
        const gamesDataElement = document.getElementById('games-data');
        if (!gamesDataElement) return;

        const games = JSON.parse(gamesDataElement.textContent || '[]');

        // Collect all checked categories and publishers
        const categories = Array.from(
          document.querySelectorAll('input[type="checkbox"][name="category"]:checked')
        ).map((el) => Number((el as HTMLInputElement).value));

        const publishers = Array.from(
          document.querySelectorAll('input[type="checkbox"][name="publisher"]:checked')
        ).map((el) => Number((el as HTMLInputElement).value));

        // Update URL and re-render
        updateURL(categories, publishers);
        const filteredGames = filterGames(games, categories, publishers);
        renderGames(filteredGames);
      }
    });

    // Initialize on page load
    initializeFiltering();
  </script>
</Layout>
